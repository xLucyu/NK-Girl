{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@app": ["./src/app"],
      "@app/*": ["./src/app/*"],
      "@btd6": ["./src/btd6"],
      "@btd6/*": ["./src/btd6/*"],
      "@commands": ["./src/commands"],
      "@commands/*": ["./src/commands/*"],
      "@database": ["./src/database"],
      "@database/*": ["./src/database/*"],
      "@discord": ["./src/discord"],
      "@discord/*": ["./src/discord/*"],
      "@lib": ["./src/lib"],
      "@lib/*": ["./src/lib/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@ui": ["./src/ui"],
      "@ui/*": ["./src/ui/*"]
    }
  },

  "include": ["src"]
}